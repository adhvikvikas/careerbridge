# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ==========================================
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/careerbridge?schema=public"
JWT_SECRET="local_dev_secret"
JWT_EXPIRES_IN="1d"
GOOGLE_CLIENT_ID="your_google_web_client_id"
FRONTEND_URL="http://localhost:5173"

# ==========================================
# TEST ENVIRONMENT VARIABLES
# ==========================================
# Keep a separate database for tests
# DATABASE_URL="postgresql://user:password@localhost:5432/careerbridge_test?schema=public"

# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# For production deployment (e.g., Render, Railway)
# PORT= (Usually injected automatically by host)
# DATABASE_URL="your_production_postgres_url"
# JWT_SECRET="your_strong_random_secret"
# JWT_EXPIRES_IN="1d"
# GOOGLE_CLIENT_ID="your_production_google_client_id"
# FRONTEND_URL="https://your-production-frontend-domain.com"
